{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.3.0"]
    },
    "mongodb": {
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@3.0.5", "--readOnly"],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "${MDB_MCP_CONNECTION_STRING:-}",
        "MDB_MCP_TELEMETRY": "disabled"
      }
    }
  }
}
