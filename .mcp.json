{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.3.0"]
    },
    "mongodb": {
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@3.0.5", "--readOnly"],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "${MDB_MCP_CONNECTION_STRING:-}",
        "MDB_MCP_TELEMETRY": "disabled"
      }
    },
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code", "--project-from-cwd", "--agent-interface", "tools", "--enable-web-dashboard", "false"],
      "env": {
        "SERENA_USAGE_REPORTING": "false"
      }
    },
    "graphify": {
      "command": "graphify-mcp",
      "args": ["graphify-out/graph.json"]
    }
  }
}
