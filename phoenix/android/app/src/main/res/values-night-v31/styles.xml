<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system splash. It is made a plain navy
         screen (no icon) so the app appears to open straight onto its own
         splash with the large logo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
