{
  "manifest_version": 3,
  "name": "فينيق · لاقط الطلبيات",
  "short_name": "لاقط فينيق",
  "version": "1.0.0",
  "description": "حوّل طلبيات الصيدليات على واتساب ويب (أو أي نص) لطلبية مرتبة ومسعّرة من كتالوج مستودعك بكبسة.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "96": "assets/icon-96.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "لاقط الطلبيات",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://feniq-connect-api.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/matcher.js",
        "src/panel.js",
        "src/whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mark-dark.png",
        "fonts/*.woff2",
        "data/demo-catalog.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "open-catcher": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "افتح لاقط الطلبيات على الصفحة الحالية"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "order-catcher@feniq.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
