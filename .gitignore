# Claude Code local settings (the shared cloud-session hook is tracked)
**/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/agents/
!/.claude/skills/

# Dependencies
**/node_modules/

# Environment variables (keep .env.example tracked)
**/.env
!**/.env.example

# Build output
**/build/

# Flutter/Dart
**/.dart_tool/
.flutter_temp/
backend/.env.example

# Impeccable review captures (regenerated each round)
.impeccable/review/
.impeccable/*.local.json

# Python publication checks
__pycache__/

# Serena (MCP): only the shared project config is tracked; caches, memories
# and per-machine overrides stay local.
.serena/*
!.serena/project.yml

# Graphify code map: rebuilt per session (AST only, ~10 s), never committed.
graphify-out/
