# Claude Code local settings (the shared cloud-session hook is tracked)
**/.claude/*
!/.claude/settings.json
!/.claude/hooks/

# Dependencies
**/node_modules/

# Environment variables (keep .env.example tracked)
**/.env
!**/.env.example

# Build output
**/build/

# Flutter/Dart
**/.dart_tool/
.flutter_temp/
backend/.env.example

# Impeccable review captures (regenerated each round)
.impeccable/review/
.impeccable/*.local.json
