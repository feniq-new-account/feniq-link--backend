# Claude Code: skills, hooks and settings.json are shared through the repo
# (every session and agent - Claude, OpenCode, Cline - loads the same ones);
# only personal local overrides stay out.
**/.claude/settings.local.json

# graphify: only GRAPH_REPORT.md is committed. graph.json (~8MB) is rebuilt in
# seconds by tools/graph/build.py (the session-start hook runs it).
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# Dependencies
**/node_modules/

# Environment variables (keep .env.example tracked)
**/.env
!**/.env.example

# Build output
**/build/

# Flutter/Dart
**/.dart_tool/
.flutter_temp/
backend/.env.example

# Impeccable review captures (regenerated each round)
.impeccable/review/
.impeccable/*.local.json
